# Copia las variables a la configuración de tu cliente MCP (no hay Client Secret: PKCE).
SPOTIFY_CLIENT_ID=tu_client_id_de_developer.spotify.com
# Opcional (por defecto 8888). El redirect URI registrado debe ser http://127.0.0.1:<puerto>/callback
SPOTIFY_REDIRECT_PORT=8888
# Opcional: read-only (por defecto) | playback
SONORA_MODE=read-only
